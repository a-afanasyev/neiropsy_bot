{
  "scales": [
    {
      "id": "hypersensitivity",
      "label": "Гиперчувствительность (избегание)",
      "rules": [
        { "when_range": { "q1": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q2": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q3": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q4": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q5": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q6": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q7": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q8": { "gte": 4 } }, "add": 1 }
      ],
      "thresholds": [
        { "gte": 0, "lt": 2, "level": "в пределах нормы" },
        { "gte": 2, "lt": 4, "level": "умеренная гиперчувствительность" },
        { "gte": 4, "level": "выраженная гиперчувствительность" }
      ]
    },
    {
      "id": "hyposensitivity",
      "label": "Гипочувствительность (сниженная реакция)",
      "rules": [
        { "when_range": { "q9": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q14": { "gte": 4 } }, "add": 1 }
      ],
      "thresholds": [
        { "gte": 0, "lt": 1, "level": "в пределах нормы" },
        { "gte": 1, "lt": 2, "level": "некоторые признаки" },
        { "gte": 2, "level": "выраженная гипочувствительность" }
      ]
    },
    {
      "id": "sensory_seeking",
      "label": "Сенсорный поиск",
      "rules": [
        { "when_range": { "q10": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q11": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q12": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q13": { "gte": 4 } }, "add": 1 },
        { "when_range": { "q15": { "gte": 4 } }, "add": 1 }
      ],
      "thresholds": [
        { "gte": 0, "lt": 2, "level": "в пределах нормы" },
        { "gte": 2, "lt": 3, "level": "умеренный сенсорный поиск" },
        { "gte": 3, "level": "выраженный сенсорный поиск" }
      ]
    }
  ],
  "overall": {
    "combine": "sum_scales",
    "overall_thresholds": [
      { "gte": 0, "lt": 3, "label": "Типичная сенсорная обработка. Сенсорные особенности в пределах нормы." },
      { "gte": 3, "lt": 6, "label": "Умеренные сенсорные особенности. Могут влиять на некоторые аспекты повседневной жизни. Рекомендуется консультация эрготерапевта." },
      { "gte": 6, "label": "Выраженные сенсорные особенности. Значительно влияют на повседневную жизнь. Настоятельно рекомендуется консультация эрготерапевта и/или нейропсихолога для разработки стратегий сенсорной интеграции." }
    ],
    "flags": [
      { "if_missing_required": true },
      {
        "if_text_contains": {
          "concerns": ["самоповреждение", "агрессия", "панические атаки", "не может выходить", "истерики"]
        }
      }
    ]
  }
}
