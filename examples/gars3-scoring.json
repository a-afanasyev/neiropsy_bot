{
  "scales": [
    {
      "id": "restricted_repetitive_behavior",
      "label": "Ограниченное и повторяющееся поведение",
      "questions": ["q9", "q10", "q11", "q12"],
      "aggregation": "sum",
      "thresholds": [4, 8, 12],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    },
    {
      "id": "social_interaction",
      "label": "Социальное взаимодействие",
      "questions": ["q1", "q2", "q3", "q4", "q14"],
      "aggregation": "sum",
      "thresholds": [5, 10, 15],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    },
    {
      "id": "communication",
      "label": "Коммуникация",
      "questions": ["q5", "q6", "q7", "q8"],
      "aggregation": "sum",
      "thresholds": [4, 8, 12],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    },
    {
      "id": "social_communication",
      "label": "Социальная коммуникация",
      "questions": ["q13", "q15"],
      "aggregation": "sum",
      "thresholds": [2, 4, 6],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    }
  ],
  "overall": {
    "strategy": "sum",
    "thresholds": [15, 30, 45],
    "labels": ["Норма", "Легкий риск аутизма", "Умеренный риск аутизма", "Высокий риск аутизма"]
  },
  "flags": [
    {
      "id": "autism_probability_low",
      "condition": "overall_score >= 15 && overall_score < 30",
      "message": "Низкая вероятность аутизма - рекомендуется наблюдение",
      "severity": "low"
    },
    {
      "id": "autism_probability_moderate",
      "condition": "overall_score >= 30 && overall_score < 45",
      "message": "Умеренная вероятность аутизма - требуется консультация специалиста",
      "severity": "high"
    },
    {
      "id": "autism_probability_high",
      "condition": "overall_score >= 45",
      "message": "Высокая вероятность аутизма - требуется комплексная диагностика",
      "severity": "high"
    },
    {
      "id": "social_communication_deficit",
      "condition": "scale.social_interaction >= 10 && scale.communication >= 8",
      "message": "Выраженный дефицит социального взаимодействия и коммуникации - требуется специализированная поддержка",
      "severity": "high"
    },
    {
      "id": "restricted_behavior",
      "condition": "scale.restricted_repetitive_behavior >= 8",
      "message": "Выраженное ограниченное и повторяющееся поведение - требуется поведенческая поддержка",
      "severity": "medium"
    }
  ]
}

