{
  "scales": [
    {
      "id": "social",
      "label": "Социальное взаимодействие",
      "rules": [
        { "when": { "q1": "no" }, "add": 2 },
        { "when": { "q1": "sometimes" }, "add": 1 },
        { "when": { "q1": "yes" }, "add": 0 },
        { "when": { "q5": "never" }, "add": 2 },
        { "when": { "q5": "rarely" }, "add": 1 }
      ],
      "thresholds": [
        { "gte": 0, "lt": 2, "level": "низкий риск" },
        { "gte": 2, "lt": 4, "level": "умеренный риск" },
        { "gte": 4, "level": "повышенный риск" }
      ]
    },
    {
      "id": "repetitive",
      "label": "Повторяющееся поведение",
      "rules": [
        { "when_range": { "q2": { "gte": 4 } }, "add": 2 },
        { "when_range": { "q2": { "gte": 3, "lt": 4 } }, "add": 1 },
        { "when_range": { "q2": { "lt": 3 } }, "add": 0 }
      ],
      "thresholds": [
        { "gte": 0, "lt": 1, "level": "низкий уровень" },
        { "gte": 1, "lt": 2, "level": "средний уровень" },
        { "gte": 2, "level": "высокий уровень" }
      ]
    }
  ],
  "overall": {
    "combine": "sum_scales",
    "overall_thresholds": [
      { "gte": 0, "lt": 2, "label": "в пределах нормы" },
      { "gte": 2, "lt": 4, "label": "требуется дополнительное наблюдение" },
      { "gte": 4, "label": "рекомендуется консультация специалиста" }
    ],
    "flags": [
      { "if_missing_required": true },
      {
        "if_text_contains": {
          "q4": ["агрессия", "самоповреждение", "нет речи", "не говорит"]
        }
      }
    ]
  }
}
