{
  "scales": [
    {
      "id": "social_interaction",
      "label": "Социальное взаимодействие",
      "questions": ["q7", "q8", "q9", "q10", "q18", "q19"],
      "aggregation": "sum",
      "thresholds": [3, 5, 6],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    },
    {
      "id": "communication",
      "label": "Коммуникация",
      "questions": ["q1", "q2", "q3", "q4", "q11", "q12", "q13", "q20"],
      "aggregation": "sum",
      "thresholds": [4, 6, 8],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    },
    {
      "id": "restricted_repetitive",
      "label": "Ограниченное и повторяющееся поведение",
      "questions": ["q5", "q6", "q14", "q15", "q16", "q17"],
      "aggregation": "sum",
      "thresholds": [3, 5, 6],
      "labels": ["Низкий", "Средний", "Высокий", "Очень высокий"]
    }
  ],
  "overall": {
    "strategy": "sum",
    "thresholds": [10, 15, 20],
    "labels": ["Норма", "Легкий риск РАС", "Умеренный риск РАС", "Высокий риск РАС"]
  },
  "flags": [
    {
      "id": "asd_risk_low",
      "condition": "overall_score >= 10 && overall_score < 15",
      "message": "Низкий риск РАС - рекомендуется наблюдение",
      "severity": "low"
    },
    {
      "id": "asd_risk_moderate",
      "condition": "overall_score >= 15 && overall_score < 20",
      "message": "Умеренный риск РАС - требуется консультация специалиста",
      "severity": "medium"
    },
    {
      "id": "asd_risk_high",
      "condition": "overall_score >= 20",
      "message": "Высокий риск РАС - требуется комплексная диагностика",
      "severity": "high"
    }
  ]
}

